FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/models/huggingface

WORKDIR /opt/finrag/api
RUN addgroup --system finrag && adduser --system --ingroup finrag finrag

COPY api/pyproject.toml ./pyproject.toml
COPY api/app ./app
COPY api/data ./data
RUN pip install --upgrade pip && pip install '.[semantic,training]'

RUN mkdir -p /models/huggingface /opt/finrag/api/artifacts && chown -R finrag:finrag /models /opt/finrag
USER finrag
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
